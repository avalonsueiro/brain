[Unit]
Description=Agent rig -- Discord channel per durable Claude Code session
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RIG_USER__
Group=__RIG_GROUP__
WorkingDirectory=__REPO_DIR__
Environment=RIG_ROOT=__RIG_ROOT__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=__RIG_ROOT__/state/agent.env
ExecStart=__REPO_DIR__/.venv/bin/python -m daemon

Restart=always
RestartSec=10

# A restart that kills live turns is how a channel loses a thought mid-sentence.
# The drop-in sets KillMode=mixed; this is the window it drains in.
TimeoutStopSec=300
KillSignal=SIGTERM

# Least privilege: the daemon runs with --dangerously-skip-permissions, so the
# containment has to come from here.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__RIG_ROOT__ /home/__RIG_USER__

[Install]
WantedBy=multi-user.target
